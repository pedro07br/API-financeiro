{
  "name": "financeiro-api",
  "version": "0.1.0",
  "description": "API do módulo Financeiro — Projeto Integrador ADS PUC Goiás / Internet das Coisas",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "keys": "ts-node scripts/gerar-chaves.ts",
    "token": "ts-node scripts/emitir-token.ts",
    "demo": "ts-node scripts/demo.ts",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "benchmark": "ts-node scripts/benchmark.ts",
    "pix": "ts-node scripts/gerar-pix.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}