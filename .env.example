# Porta HTTP do módulo
PORT=3008
# Banco de dados — o tipo é escolhido pelo início da URL.
# MySQL 8.0.16+ (o database é criado automaticamente na primeira execução):
#DATABASE_URL=mysql://root:SUA_SENHA@localhost:3306/financeiro
# PostgreSQL 13+ (usa o schema "financeiro" dentro do banco):
DATABASE_URL=postgres://financeiro:financeiro@localhost:5432/erp
# Chave PÚBLICA RS256 emitida pelo módulo de Autenticação (o Financeiro só valida, nunca assina)
JWT_PUBLIC_KEY_PATH=./keys/auth-public.pem
JWT_ISSUER=auth
# Segredo compartilhado com o PSP para assinar o webhook Pix (HMAC-SHA256)
PIX_WEBHOOK_SECRET=troque-este-segredo
# Chave Pix recebedora (usada no "copia e cola" simulado)
PIX_CHAVE_RECEBEDOR=financeiro@empresa.com.br
# Nome e cidade de quem recebe, exibidos no app do banco ao ler o QR Code
PIX_NOME_RECEBEDOR=EMPRESA
PIX_CIDADE_RECEBEDOR=GOIANIA
# Liga/desliga os agendadores (cron). Em testes fica desligado e os jobs são chamados direto.
JOBS_ENABLED=true
# Regras de encargos por atraso
MULTA_PERCENTUAL=2
JUROS_MENSAL_PERCENTUAL=1
